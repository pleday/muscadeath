# Copy this file to .env.local and fill in your Supabase project credentials
# (Project Settings > API in the Supabase dashboard). Without these, the
# admin panel falls back to local-only editing (see README.md).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Cloud API key with the "Places API" and "Maps Embed API" enabled
# (see README.md). Without it, address fields fall back to plain text input
# and the map falls back to the keyless Google Maps embed.
VITE_GOOGLE_MAPS_API_KEY=
